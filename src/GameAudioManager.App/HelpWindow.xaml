<Window x:Class="GameAudioManager.App.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:GameAudioManager.App"
        Title="使い方 / How to use"
        Icon="Assets/app.ico"
        Height="720" Width="820"
        MinHeight="420" MinWidth="560"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"
                   Text="{Binding [HelpTitle], Source={x:Static app:Localization.Instance}}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="14"
                           Text="{Binding [HelpIntro], Source={x:Static app:Localization.Instance}}" />

                <TextBlock Margin="0,18,0,6" FontWeight="SemiBold" FontSize="15"
                           Text="{Binding [HelpFlowTitle], Source={x:Static app:Localization.Instance}}" />
                <TextBlock TextWrapping="Wrap"
                           Text="{Binding [HelpFlow], Source={x:Static app:Localization.Instance}}" />

                <TextBlock Margin="0,18,0,6" FontWeight="SemiBold" FontSize="15"
                           Text="{Binding [HelpColumnsTitle], Source={x:Static app:Localization.Instance}}" />
                <TextBlock TextWrapping="Wrap"
                           Text="{Binding [HelpColumns], Source={x:Static app:Localization.Instance}}" />

                <TextBlock Margin="0,18,0,6" FontWeight="SemiBold" FontSize="15"
                           Text="{Binding [HelpTimingTitle], Source={x:Static app:Localization.Instance}}" />
                <TextBlock TextWrapping="Wrap"
                           Text="{Binding [HelpTiming], Source={x:Static app:Localization.Instance}}" />

                <TextBlock Margin="0,18,0,6" FontWeight="SemiBold" FontSize="15"
                           Text="{Binding [HelpKeysTitle], Source={x:Static app:Localization.Instance}}" />
                <TextBlock TextWrapping="Wrap"
                           Text="{Binding [HelpKeys], Source={x:Static app:Localization.Instance}}" />

                <TextBlock Margin="0,18,0,6" FontWeight="SemiBold" FontSize="15"
                           Text="{Binding [HelpTroubleTitle], Source={x:Static app:Localization.Instance}}" />
                <TextBlock TextWrapping="Wrap"
                           Text="{Binding [HelpTrouble], Source={x:Static app:Localization.Instance}}" />

                <TextBlock Margin="0,18,0,6" FontWeight="SemiBold" FontSize="15"
                           Text="{Binding [HelpFilesTitle], Source={x:Static app:Localization.Instance}}" />
                <TextBlock TextWrapping="Wrap"
                           Text="{Binding [HelpFiles], Source={x:Static app:Localization.Instance}}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button MinWidth="110" Height="32" Click="OnOpenDocs"
                    Content="{Binding [HelpOpenDocs], Source={x:Static app:Localization.Instance}}" />
            <Button MinWidth="100" Height="32" Margin="8,0,0,0" Click="OnClose"
                    Content="{Binding [HelpClose], Source={x:Static app:Localization.Instance}}" />
        </StackPanel>
    </Grid>
</Window>
