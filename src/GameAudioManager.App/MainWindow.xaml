<Window x:Class="GameAudioManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Audio Manager"
        Height="620" Width="920"
        MinHeight="420" MinWidth="760"
        UseLayoutRounding="True"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="アプリケーション" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button x:Name="RefreshButton" Content="更新" Width="88" Height="30" Margin="16,0,0,0" Click="OnRefresh" />
            <TextBlock x:Name="BusyText" Text="読み込み中…" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>

        <ListView Grid.Row="1"
                  x:Name="AppList"
                  ItemsSource="{Binding Apps}"
                  SelectedItem="{Binding SelectedApp, Mode=TwoWay}"
                  SelectionMode="Single"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="アプリ" Width="270" DisplayMemberBinding="{Binding DisplayName}" />
                    <GridViewColumn Header="状態" Width="100" DisplayMemberBinding="{Binding StatusText}" />
                    <GridViewColumn Header="ミュート" Width="120" DisplayMemberBinding="{Binding MuteText}" />
                    <GridViewColumn Header="プロセス" Width="200" DisplayMemberBinding="{Binding ProcessName}" />
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="2" Margin="0,12,0,0" Padding="12" BorderThickness="1" CornerRadius="4"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="出力先" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Row="0" Grid.Column="1"
                          x:Name="DeviceCombo"
                          ItemsSource="{Binding Devices}"
                          SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          Height="30" VerticalContentAlignment="Center">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="ToolTip" Value="{Binding Id}" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
                <Button x:Name="ApplyButton" Grid.Row="0" Grid.Column="2" Content="適用" Width="90" Height="30" Margin="8,0,0,0" Click="OnApply" />

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="ResetButton" Content="Windows の既定へ戻す" Width="180" Height="30" Click="OnReset" />
                    <Button x:Name="MuteButton" Content="ミュート切替" Width="130" Height="30" Margin="8,0,0,0" Click="OnToggleMute" />
                    <TextBlock x:Name="HintText" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.7"
                               Text="出力先の変更は、アプリが次に音声セッションを作るときに反映されます。" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Margin="0,10,0,0"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap" MinHeight="34" VerticalAlignment="Top" />
    </Grid>
</Window>
