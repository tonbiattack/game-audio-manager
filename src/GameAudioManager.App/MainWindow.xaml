<Window x:Class="GameAudioManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Audio Manager"
        Height="700" Width="1180"
        MinHeight="520" MinWidth="900"
        UseLayoutRounding="True"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- header -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="アプリケーション" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBox x:Name="FilterBox" Width="220" Height="28" Margin="20,0,0,0"
                     VerticalContentAlignment="Center"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="検索" Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.6" />
            <CheckBox Content="未起動も表示" Margin="18,0,0,0" VerticalAlignment="Center"
                      IsChecked="{Binding ShowNotRunning, Mode=TwoWay}" />
            <Button Content="更新" Width="80" Height="28" Margin="18,0,0,0" Click="OnRefresh" />
            <Button x:Name="WatcherButton" Content="自動適用を停止" Width="130" Height="28" Margin="8,0,0,0" Click="OnToggleWatcher" />
        </StackPanel>

        <!-- list -->
        <ListView Grid.Row="1" Grid.Column="0"
                  x:Name="AppList"
                  ItemsSource="{Binding AppsView}"
                  SelectedItem="{Binding SelectedApp, Mode=TwoWay}"
                  SelectionMode="Single"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="アプリ" Width="200" DisplayMemberBinding="{Binding DisplayName}" />
                    <GridViewColumn Header="状態" Width="100" DisplayMemberBinding="{Binding StateText}" />
                    <GridViewColumn Header="出力先" Width="190" DisplayMemberBinding="{Binding DeviceText}" />
                    <GridViewColumn Header="ミュート" Width="90" DisplayMemberBinding="{Binding MuteText}" />
                    <GridViewColumn Header="自動" Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsAutoApplyEnabled, Mode=OneWay}"
                                          Click="OnAutoApplyToggled"
                                          Tag="{Binding}"
                                          ToolTip="このアプリの出力先を自動で維持する" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="プロセス" Width="150" DisplayMemberBinding="{Binding ProcessName}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- priority editor -->
        <Border Grid.Row="1" Grid.Column="1" Width="290" Margin="12,0,0,0" Padding="10" BorderThickness="1" CornerRadius="4"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="優先デバイス順（上が優先）" FontWeight="SemiBold" Margin="0,0,0,6" />

                <ListBox Grid.Row="1" x:Name="PriorityList" ItemsSource="{Binding PriorityDeviceNames}" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="候補に追加" Width="100" Height="26" Click="OnAddPriority" />
                    <Button Content="削除" Width="70" Height="26" Margin="6,0,0,0" Click="OnRemovePriority" />
                </StackPanel>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="上へ" Width="100" Height="26" Click="OnMovePriorityUp" />
                    <Button Content="下へ" Width="70" Height="26" Margin="6,0,0,0" Click="OnMovePriorityDown" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- actions -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0" Padding="12" BorderThickness="1" CornerRadius="4"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="出力先" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Row="0" Grid.Column="1"
                          ItemsSource="{Binding Devices}"
                          SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          Height="30" VerticalContentAlignment="Center" />
                <Button x:Name="ApplyButton" Grid.Row="0" Grid.Column="2" Content="適用" Width="90" Height="30" Margin="8,0,0,0" Click="OnApply" />

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="ResetButton" Content="Windows の既定へ戻す" Width="180" Height="30" Click="OnReset" />
                    <Button x:Name="MuteButton" Content="ミュート切替" Width="130" Height="30" Margin="8,0,0,0" Click="OnToggleMute" />
                    <CheckBox x:Name="AutoStartCheck" Content="ログオン時に自動起動" Margin="18,0,0,0" VerticalAlignment="Center"
                              IsChecked="{Binding AutoStartWithWindows, Mode=TwoWay}" />
                    <TextBlock Margin="18,0,0,0" VerticalAlignment="Center" Opacity="0.7"
                               Text="出力先の変更は、アプリが次に音声セッションを作るときに反映されます。" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Margin="0,10,0,0"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap" MinHeight="34" VerticalAlignment="Top" />
    </Grid>
</Window>


