<Window x:Class="GameAudioManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:app="clr-namespace:GameAudioManager.App"
        Title="Game Audio Manager"
        Icon="Assets/app.ico"
        Height="720" Width="1200"
        MinHeight="520" MinWidth="920"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- header -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="{Binding [Header], Source={x:Static app:Localization.Instance}}"
                       FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBox x:Name="FilterBox" Width="220" Height="30" Margin="20,0,0,0"
                     VerticalContentAlignment="Center"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{Binding [Search], Source={x:Static app:Localization.Instance}}" />
            <TextBlock Text="{Binding [Search], Source={x:Static app:Localization.Instance}}"
                       Margin="6,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppSubtleBrush}" />
            <CheckBox Content="{Binding [ShowNotRunning], Source={x:Static app:Localization.Instance}}"
                      Margin="18,0,0,0" VerticalAlignment="Center"
                      IsChecked="{Binding ShowNotRunning, Mode=TwoWay}" />
            <ui:Button x:Name="RefreshButton" Margin="18,0,0,0" Height="30" MinWidth="84"
                       Content="{Binding [Refresh], Source={x:Static app:Localization.Instance}}"
                       Click="OnRefresh" />
            <ui:Button x:Name="WatcherButton" Margin="8,0,0,0" Height="30" MinWidth="140"
                       Click="OnToggleWatcher" />

            <TextBlock Text="{Binding [Theme], Source={x:Static app:Localization.Instance}}"
                       Margin="18,0,6,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppSubtleBrush}" />
            <ComboBox x:Name="ThemeCombo" Width="120" Height="30" Margin="0"
                      VerticalContentAlignment="Center"
                      SelectionChanged="OnThemeChanged" />

            <TextBlock Text="{Binding [Language], Source={x:Static app:Localization.Instance}}"
                       Margin="16,0,6,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppSubtleBrush}" />
            <ComboBox x:Name="LanguageCombo" Width="120" Height="30"
                      VerticalContentAlignment="Center"
                      SelectionChanged="OnLanguageChanged" />

            <ui:Button Content="{Binding [ImportLegacy], Source={x:Static app:Localization.Instance}}"
                       Margin="12,0,0,0" Height="30" Click="OnImportLegacy" />
            <ui:Button Content="{Binding [Help], Source={x:Static app:Localization.Instance}}"
                       Margin="8,0,0,0" Height="30" MinWidth="80" Click="OnOpenHelp" />
        </StackPanel>

        <!-- list -->
        <ListView Grid.Row="1" Grid.Column="0"
                  x:Name="AppList"
                  ItemsSource="{Binding AppsView}"
                  SelectedItem="{Binding SelectedApp, Mode=TwoWay}"
                  SelectionMode="Single"
                  AlternationCount="2"
                  Background="{DynamicResource AppBackgroundBrush}"
                  Foreground="{DynamicResource AppForegroundBrush}"
                  BorderBrush="{DynamicResource AppBorderBrush}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="220"
                                    Header="{Binding [ColumnApp], Source={x:Static app:Localization.Instance}}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Icon}" Width="16" Height="16"
                                           Margin="2,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="110"
                                    Header="{Binding [ColumnState], Source={x:Static app:Localization.Instance}}"
                                    DisplayMemberBinding="{Binding StateText}" />
                    <GridViewColumn Width="200"
                                    Header="{Binding [ColumnOutput], Source={x:Static app:Localization.Instance}}"
                                    DisplayMemberBinding="{Binding DeviceText}" />
                    <GridViewColumn Width="90"
                                    Header="{Binding [ColumnMute], Source={x:Static app:Localization.Instance}}"
                                    DisplayMemberBinding="{Binding MuteText}" />
                    <GridViewColumn Width="60"
                                    Header="{Binding [ColumnAuto], Source={x:Static app:Localization.Instance}}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsAutoApplyEnabled, Mode=OneWay}"
                                          Click="OnAutoApplyToggled"
                                          Tag="{Binding}"
                                          MinWidth="24" MinHeight="24"
                                          HorizontalAlignment="Center"
                                          ToolTip="{Binding [ColumnAuto], Source={x:Static app:Localization.Instance}}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="150"
                                    Header="{Binding [ColumnProcess], Source={x:Static app:Localization.Instance}}"
                                    DisplayMemberBinding="{Binding ProcessName}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- priority editor -->
        <Border Grid.Row="1" Grid.Column="1" Width="300" Margin="14,0,0,0" Padding="12"
                BorderThickness="1" CornerRadius="6"
                Background="{DynamicResource AppPanelBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontWeight="SemiBold" Margin="0,0,0,8"
                           Text="{Binding [PriorityTitle], Source={x:Static app:Localization.Instance}}" />

                <ListBox Grid.Row="1" x:Name="PriorityList" ItemsSource="{Binding PriorityDeviceNames}"
                         Background="{DynamicResource AppBackgroundBrush}"
                         Foreground="{DynamicResource AppForegroundBrush}"
                         BorderBrush="{DynamicResource AppBorderBrush}" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <ui:Button MinWidth="110" Height="30"
                               Content="{Binding [AddCandidate], Source={x:Static app:Localization.Instance}}"
                               Click="OnAddPriority" />
                    <ui:Button MinWidth="80" Height="30" Margin="8,0,0,0"
                               Content="{Binding [RemoveCandidate], Source={x:Static app:Localization.Instance}}"
                               Click="OnRemovePriority" />
                </StackPanel>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                    <ui:Button MinWidth="110" Height="30"
                               Content="{Binding [MoveUp], Source={x:Static app:Localization.Instance}}"
                               Click="OnMovePriorityUp" />
                    <ui:Button MinWidth="80" Height="30" Margin="8,0,0,0"
                               Content="{Binding [MoveDown], Source={x:Static app:Localization.Instance}}"
                               Click="OnMovePriorityDown" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- actions -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="0,14,0,0" Padding="14"
                BorderThickness="1" CornerRadius="6"
                Background="{DynamicResource AppPanelBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                           Text="{Binding [OutputLabel], Source={x:Static app:Localization.Instance}}" />
                <ComboBox Grid.Row="0" Grid.Column="1"
                          ItemsSource="{Binding Devices}"
                          SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          Height="32" VerticalContentAlignment="Center" />
                <ui:Button x:Name="ApplyButton" Grid.Row="0" Grid.Column="2" MinWidth="90" Height="32" Margin="8,0,0,0"
                           Content="{Binding [Apply], Source={x:Static app:Localization.Instance}}"
                           Click="OnApply" />

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,12,0,0">
                    <ui:Button x:Name="ResetButton" MinWidth="190" Height="32"
                               Content="{Binding [ResetToDefault], Source={x:Static app:Localization.Instance}}"
                               Click="OnReset" />
                    <ui:Button x:Name="MuteButton" MinWidth="140" Height="32" Margin="8,0,0,0" Click="OnToggleMute" />
                    <CheckBox Margin="20,0,0,0" VerticalAlignment="Center"
                              Content="{Binding [AutoStartWithWindows], Source={x:Static app:Localization.Instance}}"
                              IsChecked="{Binding AutoStartWithWindows, Mode=TwoWay}" />
                    <TextBlock Margin="20,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource AppSubtleBrush}"
                               Text="{Binding [RoutingHint], Source={x:Static app:Localization.Instance}}" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Margin="0,10,0,0"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap" MinHeight="36" VerticalAlignment="Top" />
    </Grid>
</Window>

