<Application x:Class="GameAudioManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Replaced at startup by ThemeManager.Apply(). -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AppForegroundBrush" Color="#1B1B1B" />
        <SolidColorBrush x:Key="AppPanelBrush" Color="#F7F7F7" />
        <SolidColorBrush x:Key="AppBorderBrush" Color="#C8C8C8" />
        <SolidColorBrush x:Key="AppSubtleBrush" Color="#606060" />
        <SolidColorBrush x:Key="AppHeaderBrush" Color="#ECECEC" />

        <!-- Rows and headers inherit the theme so the dark palette does not leave a white grid. -->
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
            <Setter Property="Padding" Value="2,3" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppHeaderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource AppHeaderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
        </Style>
    </Application.Resources>
</Application>

