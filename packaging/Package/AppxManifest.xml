<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <Identity
    Name="tonbiattack.GameAudioManager"
    Publisher="CN=2F14A66E-02DF-43E2-93E0-5C5900B38D2E"
    Version="0.2.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Game Audio Manager</DisplayName>
    <PublisherDisplayName>tonbiattack</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>アプリ・ゲームごとの音声出力先とミュートを切り替える常駐アプリ</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="ja-jp" />
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="GameAudioManager" Executable="GameAudioManager.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Game Audio Manager"
        Description="アプリ・ゲームごとの音声出力先とミュートを切り替えます"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Square150x150Logo.png" />
      </uap:VisualElements>

      <Extensions>
        <!--
          Logon autostart for the packaged build. Writing HKCU\...\Run from inside a
          package is virtualized and never read at logon, so the packaged build uses a
          startup task instead. It is declared disabled: the in-app toggle asks Windows
          to enable it, and Windows records the answer in Task Manager's Startup tab.
          Application extensions must stay inside <Application> to satisfy the schema.
        -->
        <uap5:Extension Category="windows.startupTask"
                         Executable="GameAudioManager.exe"
                         EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="GameAudioManagerStartup"
                            Enabled="false"
                            DisplayName="Game Audio Manager" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <!--
    NOTE: `unvirtualizedResources` is intentionally NOT requested here. Routing goes
    through the audio policy API rather than HKCU, and the packaged build keeps its
    settings in the package's LocalState, so registry/file virtualization does not need
    to be bypassed. See docs/msix-verification.md for what was measured.
  -->
</Package>
